{
  "description": "RepoCharter safety and write-measurement hooks. Review and trust this project layer with /hooks after installation or change.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "AGENTKIT_HARNESS=codex \"$(git rev-parse --show-toplevel)/.claude/hooks/agentkit/pretooluse-bash.sh\"",
            "statusMessage": "Checking command policy"
          }
        ]
      },
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "AGENTKIT_HARNESS=codex \"$(git rev-parse --show-toplevel)/.claude/hooks/agentkit/pretooluse-write.py\"",
            "statusMessage": "Checking write policy"
          }
        ]
      },
      {
        "matcher": "^mcp__.*$",
        "hooks": [
          {
            "type": "command",
            "command": "AGENTKIT_HARNESS=codex \"$(git rev-parse --show-toplevel)/.claude/hooks/agentkit/pretooluse-mcp.py\"",
            "statusMessage": "Checking MCP policy"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "AGENTKIT_HARNESS=codex \"$(git rev-parse --show-toplevel)/.claude/hooks/agentkit/posttooluse-write.py\"",
            "statusMessage": "Measuring written content"
          }
        ]
      }
    ]
  }
}
