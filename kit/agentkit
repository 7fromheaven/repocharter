)


# ── helpers ───────────────────────────────────────────────────────────────────────────

def say(msg: str) -> None:
    print(f"  {msg}")


def read_json(path: Path, default=None):
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return default


def write_json(path: Path, data: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")


def agentkit_state_dir() -> Path:
    """Machine-local recoverable state, overrideable for sandboxed tests and CI."""
    return Path(os.environ.get("AGENTKIT_STATE_DIR") or (Path.home() / ".agentkit"))


def codex_adapter_digest(repo: Path) -> str | None:
    """Hash the exact provider wiring a live Codex self-test certifies."""
    digest = hashlib.sha256()
    for rel in CODEX_ADAPTER_FILES:
        path = repo / rel
        if not path.is_file():
            return None
        digest.update(rel.encode("utf-8"))
        digest.update(b"\0")
        digest.update(path.read_bytes())
        digest.update(b"\0")
    return digest.hexdigest()


