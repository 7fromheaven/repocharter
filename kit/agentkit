def _run_codex_exec(repo: Path, prompt: str) -> subprocess.CompletedProcess:
    command = [
        "codex", "exec", "--ephemeral", "--strict-config", "--ignore-rules",
        "--dangerously-bypass-hook-trust", "--json", "-s", "workspace-write",
        "-C", str(repo), "-c", 'approval_policy="never"', prompt,
    ]
    return subprocess.run(command, cwd=repo, capture_output=True, text=True, timeout=300)


def _run_codex_trust_probe(repo: Path) -> subprocess.CompletedProcess:
    """Run without the automation-only hook-trust bypass in the actual target repo."""
    prompt = (
        "Use Bash exactly once to run: git -c core.hooksPath=/dev/null status. "
        "Do not retry or use another tool. Stop after the attempt."
    )
    command = [
        "codex", "exec", "--ephemeral", "--strict-config", "--ignore-rules", "--json",
        "-s", "workspace-write", "-C", str(repo), "-c", 'approval_policy="never"', prompt,
    ]
    return subprocess.run(command, cwd=repo, capture_output=True, text=True, timeout=300)


def copy_codex_probe_adapter(
        repo: Path, probe: Path, closure: codex_hooks_lib.CodexHookClosure) -> None:
    """Install the exact managed and preserved Codex adapter closure into a probe repo."""
    shutil.copytree(repo / ".claude" / "hooks", probe / ".claude" / "hooks")
    (probe / ".codex").mkdir()
    shutil.copy2(repo / ".codex" / "hooks.json", probe / ".codex" / "hooks.json")
    codex_hooks_lib.copy_dependencies(repo, probe, closure)


