def say(msg: str) -> None:
    print(f"  {msg}")


def read_json(path: Path, default=None):
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return default


def write_json(path: Path, data: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")


def agentkit_state_dir() -> Path:
    """Machine-local recoverable state, overrideable for sandboxed tests and CI."""
    return Path(os.environ.get("AGENTKIT_STATE_DIR") or (Path.home() / ".agentkit"))


def adapter_digest(repo: Path, files: tuple[str, ...]) -> str | None:
    """Hash the exact provider wiring a live self-test certifies.

    A missing file returns None rather than a digest over what remains, so a half-installed
    adapter can never match a recorded hash.
    """
    digest = hashlib.sha256()
    for rel in files:
        path = repo / rel
        if not path.is_file():
            return None
        digest.update(rel.encode("utf-8"))
        digest.update(b"\0")
        digest.update(path.read_bytes())
        digest.update(b"\0")
    return digest.hexdigest()


def codex_adapter_digest(repo: Path) -> str | None:
    closure = codex_hooks_lib.discover(repo)
    if closure.errors:
        return None
    files = CODEX_ADAPTER_FILES + tuple(
        path for path in closure.dependencies if path not in CODEX_ADAPTER_FILES
    )
    return adapter_digest(repo, files)


def claude_adapter_digest(repo: Path) -> str | None:
    return adapter_digest(repo, CLAUDE_ADAPTER_FILES)


CHECKOUT_EVIDENCE_VERSION = 1


def checkout_git_dir(repo: Path) -> Path | None:
    """Return this worktree's private Git directory, never the shared common dir."""
    try:
        proc = subprocess.run(
            ["git", "rev-parse", "--absolute-git-dir"], cwd=repo,
            capture_output=True, text=True, timeout=15,
        )
    except (FileNotFoundError, subprocess.TimeoutExpired):
        return None
    path = proc.stdout.strip()
    return Path(path) if proc.returncode == 0 and path else None


def checkout_evidence_path(repo: Path, harness: str) -> Path | None:
    git_dir = checkout_git_dir(repo)
    if git_dir is None:
        return None
    return git_dir / "agentkit" / "enforcement" / f"{harness}.json"


def checkout_evidence_record(repo: Path, harness: str, evidence: dict) -> dict:
    """Machine-local proof paired with the tracked repository-level evidence."""
    return {
        "formatVersion": CHECKOUT_EVIDENCE_VERSION,
        "agentkitVersion": KIT_VERSION,
        "checkout": str(repo.resolve()),
        "provider": harness,
        "evidence": evidence,
    }


def write_checkout_evidence(repo: Path, harness: str, evidence: dict) -> bool:
    path = checkout_evidence_path(repo, harness)
    if path is None:
        return False
    write_json(path, checkout_evidence_record(repo, harness, evidence))
    return True


def provider_promotion_state(repo: Path, harness: str, compat: dict | None = None) -> dict:
    """Say whether this checkout can reuse its existing live provider evidence.

    This is deliberately stricter than a tracked `blocking` declaration. Reuse also requires
    the exact adapter bytes, provider version, checkout-local attestation, effective provider
    settings, and (for Codex) the exact trusted project hook source.
    """
    compat = compat if isinstance(compat, dict) else (
        read_json(repo / ".agents" / "compatibility.json", {}) or {}
    )
    if harness not in {"codex", "claude-code"}:
        return {
            "current": False,
            "promotionRequired": True,
            "installedVersion": None,
            "reasons": [f"{harness} has no provider-specific promotion implementation"],
            "discovery": None,
        }

    executable = "codex" if harness == "codex" else "claude"
    reasons: list[str] = []
    enforcement = (compat.get("enforcement") or {}).get(harness, "advisory")
    if enforcement != "blocking":
        reasons.append("enforcement declaration is advisory")
    if compat.get("agentkitVersion") != KIT_VERSION:
        reasons.append(
            f"manifest version {compat.get('agentkitVersion')!r} does not match kit {KIT_VERSION!r}"
        )

    evidence = (compat.get("enforcementEvidence") or {}).get(harness)
    if not isinstance(evidence, dict):
        reasons.append("tracked live evidence is missing")
        evidence = None

    digest = claude_adapter_digest(repo) if harness == "claude-code" \
        else codex_adapter_digest(repo)
    if evidence is not None and digest != evidence.get("adapterSha256"):
        reasons.append("adapter bytes differ from the tracked evidence")

    version = ""
    if shutil.which(executable) is None:
        reasons.append(f"{executable} is unavailable in this environment")
    else:
        try:
            proc = subprocess.run(
                [executable, "--version"], cwd=repo, capture_output=True,
                text=True, timeout=30,
            )
        except (OSError, subprocess.TimeoutExpired) as exc:
            reasons.append(f"could not read {executable} version: {exc}")
        else:
            version = proc.stdout.strip()
            if proc.returncode != 0 or not version:
                reasons.append(f"could not read {executable} version")
            elif evidence is not None and version != evidence.get("harnessVersion"):
                reasons.append("installed provider version differs from the tracked evidence")

    local_path = checkout_evidence_path(repo, harness)
    local = read_json(local_path) if local_path is not None else None
    expected_local = checkout_evidence_record(repo, harness, evidence) \
        if evidence is not None else None
    if local != expected_local:
        reasons.append("checkout-local attestation is missing, stale, or belongs elsewhere")

    discovery = None
    if harness == "codex" and version:
        discovered = codex_hooks_lib.query_discovery(repo)
        discovery = {
            "status": discovered.status,
            "expectedPath": discovered.expected_path,
            "sourcePaths": list(discovered.source_paths),
            "trustStatuses": list(discovered.trust_statuses),
            "warnings": list(discovered.warnings),
            "errors": list(discovered.errors),
        }
        problem = codex_hooks_lib.discovery_problem(repo, discovered)
        if problem:
            reasons.append(problem)
        elif discovered.warnings:
            reasons.append("Codex reported project-hook discovery warnings")
        elif not discovered.trust_statuses or any(
                value != "trusted" for value in discovered.trust_statuses):
            reasons.append("the exact Codex hook definitions have not all been trusted")
    elif harness == "claude-code" and version:
        failures, trust_root = claude_checkout_preflight(repo)
        reasons.extend(failures)
        discovery = {"trustRoot": str(trust_root) if trust_root is not None else None}

    return {
        "enforcement": enforcement,
        "installedVersion": version or None,
        "evidence": evidence,
        "adapterSha256": digest,
        "localAttestation": str(local_path) if local_path is not None else None,
        "discovery": discovery,
        "current": not reasons,
        "promotionRequired": bool(reasons),
        "reasons": reasons,
    }


def claude_config_dir() -> Path:
    raw = os.environ.get("CLAUDE_CONFIG_DIR")
    return Path(raw).expanduser() if raw else Path.home() / ".claude"


def claude_state_path() -> Path:
    """Claude's app-state file, which documents per-project trust under `projects`."""
    config_dir = claude_config_dir()
    if os.environ.get("CLAUDE_CONFIG_DIR"):
        candidates = (Path(f"{config_dir}.json"), config_dir / ".claude.json")
        return next((path for path in candidates if path.is_file()), candidates[0])
    return Path.home() / ".claude.json"


def claude_trust_root(repo: Path) -> Path | None:
    """Return the most specific persisted Claude trust boundary covering this checkout."""
    state = read_json(claude_state_path(), {}) or {}
    projects = state.get("projects")
    if not isinstance(projects, dict):
        return None
    target = repo.resolve()
    trusted: list[Path] = []
    for raw, project in projects.items():
        if not isinstance(raw, str) or not isinstance(project, dict):
            continue
        if project.get("hasTrustDialogAccepted") is not True:
            continue
        candidate = Path(raw).expanduser().resolve()
        try:
            target.relative_to(candidate)
        except (ValueError, OSError):
            continue
        trusted.append(candidate)
    return max(trusted, key=lambda path: len(path.parts), default=None)


def claude_local_settings_paths(repo: Path) -> list[Path]:
    """Paths Claude may use for this repo's machine-local settings, including worktrees."""
    paths = [repo / ".claude" / "settings.local.json"]
    try:
        proc = subprocess.run(
            ["git", "worktree", "list", "--porcelain"], cwd=repo,
            capture_output=True, text=True, timeout=15,
        )
    except (FileNotFoundError, subprocess.TimeoutExpired):
        proc = None
    if proc is not None and proc.returncode == 0:
        first = next((line.removeprefix("worktree ") for line in proc.stdout.splitlines()
                      if line.startswith("worktree ")), "")
        if first:
            paths.append(Path(first) / ".claude" / "settings.local.json")
    unique: list[Path] = []
    for path in paths:
        resolved = path.resolve()
        if resolved not in unique:
            unique.append(resolved)
    return unique


def claude_checkout_preflight(repo: Path) -> tuple[list[str], Path | None]:
    """Inspect the target checkout conditions the disposable probe intentionally cannot own."""
    failures: list[str] = []
    trust_root = claude_trust_root(repo)
    if trust_root is None:
        failures.append(
            "workspace trust is not persisted for this checkout or a covering parent. Start "
            "`claude` interactively here, review the project settings/hooks, accept the trust "
            "dialog, then rerun promotion"
        )

    settings_paths = [repo / ".claude" / "settings.json", *claude_local_settings_paths(repo),
                      claude_config_dir() / "settings.json"]
    seen: set[Path] = set()
    for path in settings_paths:
        path = path.resolve()
        if path in seen or not path.exists():
            continue
        seen.add(path)
        data = read_json(path)
        if not isinstance(data, dict):
            failures.append(f"{path} is not valid object-valued JSON, so effective Claude settings are unknown")
        elif data.get("disableAllHooks") is True:
            failures.append(f"{path} sets disableAllHooks, so project hooks are inert")
    if os.environ.get("CLAUDE_CODE_SAFE_MODE"):
        failures.append("CLAUDE_CODE_SAFE_MODE is set, so this process cannot prove project hooks")
    return failures, trust_root


