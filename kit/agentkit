def configchange_fixture_checks(repo: Path) -> int:
    """Fire this checkout's INSTALLED ConfigChange guard in a throwaway copy of a repo.

    The fixture is what makes this safe to run anywhere: a case that fails, or a guard that
    wrongly allows a disarm, touches a temporary directory and never this checkout's own
    settings. The payloads are the shape the harness really sends -- a source and a path,
    with no settings content -- because a guard tested only against a synthetic payload
    carrying `new_settings` passes while enforcing nothing.
    """
    guard = repo / HOOK_DIR_NAME / "configchange-guard.py"
    if not guard.is_file():
        print("  FAIL  ConfigChange guard: configchange-guard.py is not installed")
        return 1

    failures = 0
    with tempfile.TemporaryDirectory(prefix="agentkit-configchange-fixture.") as raw:
        fixture = Path(raw)
        shutil.copytree(repo / HOOK_DIR_NAME, fixture / HOOK_DIR_NAME)
        write_json(fixture / ".agents" / "compatibility.json",
                   {"policy": {"denyWritePaths": [{"glob": "fixture/**", "reason": "fixture"}]}})
        settings_path = fixture / ".claude" / "settings.json"
        payload = {"hook_event_name": "ConfigChange", "source": "project_settings",
                   "file_path": str(settings_path)}

        healthy = json.loads(json.dumps(CONFIGCHANGE_FIXTURE_SETTINGS))
        disarmed = {**json.loads(json.dumps(healthy)), "disableAllHooks": True}
        undenied = json.loads(json.dumps(healthy))
        undenied["permissions"]["deny"] = []
        ungated = json.loads(json.dumps(healthy))
        del ungated["hooks"]["PreToolUse"]
        noop = json.loads(json.dumps(healthy))
        noop["hooks"]["PreToolUse"][0]["hooks"][0]["command"] = "true"

        for label, settings, expected in (
            ("an ordinary settings reload", healthy, 0),
            ("disableAllHooks", disarmed, 2),
            ("an emptied permissions.deny", undenied, 2),
            ("a removed PreToolUse hook", ungated, 2),
            ("a same-event no-op Bash handler", noop, 2),
        ):
            write_json(settings_path, settings)
            env = dict(os.environ, CLAUDE_PROJECT_DIR=str(fixture))
            env.pop("AGENTKIT_HARNESS", None)
            proc = subprocess.run([str(guard)], input=json.dumps(payload), capture_output=True,
                                  text=True, env=env, cwd=fixture, timeout=30)
            ok = proc.returncode == expected
            verb = "allowed" if expected == 0 else "refused"
            print(f"  {'pass ' if ok else 'FAIL '} ConfigChange fixture — {label} is {verb}: "
                  f"expected exit {expected}, got {proc.returncode}")
            failures += 0 if ok else 1
    return failures


def cmd_self_test(repo: Path, promote_codex: bool = False,
                  promote_claude: bool = False) -> int:
    print(f"agentkit self-test -> {repo}\n")
    hook_dir = repo / HOOK_DIR_NAME
    if not hook_dir.is_dir():
        print("  ERROR: no installed hooks. Run `agentkit apply` first.", file=sys.stderr)
        return 2

    failures = 0
    for hook_name, payload, expected, label in CASES:
        hook = hook_dir / hook_name
        if not hook.exists():
            print(f"  FAIL  {label}: {hook_name} is not installed")
            failures += 1
            continue
        try:
            code, out = run_hook(hook, payload, repo)
        except subprocess.TimeoutExpired:
            print(f"  FAIL  {label}: hook timed out")
            failures += 1
            continue
        actual = decision_of(code, out)
        ok = actual == expected
        print(f"  {'pass ' if ok else 'FAIL '} {label}: expected {expected}, got {actual}")
        failures += 0 if ok else 1

    # The fail-closed property, which is the one that was wrong before: a gate that cannot
    # parse its input must refuse, not wave the call through.
    bash_hook = hook_dir / "pretooluse-bash.sh"
    if bash_hook.exists():
        proc = subprocess.run([str(bash_hook)], input="not json at all",
                              capture_output=True, text=True, cwd=repo, timeout=30)
        ok = proc.returncode == 2
        print(f"  {'pass ' if ok else 'FAIL '} malformed payload fails CLOSED: "
              f"expected exit 2, got {proc.returncode}")
        failures += 0 if ok else 1

        code, out = run_hook(
            bash_hook,
            {"tool_name": "Bash", "tool_input": {"command": "git reset --hard HEAD~1"}},
            repo,
            harness="codex",
        )
        actual = decision_of(code, out)
        ok = actual == "allow" and "native permission request" in context_of(out)
        print(f"  {'pass ' if ok else 'FAIL '} Codex hands ask to native approval: "
              f"expected approval handoff, got {actual}")
        failures += 0 if ok else 1

        code, out = run_hook(
            bash_hook,
            {"permission_mode": "bypassPermissions", "tool_name": "Bash",
             "tool_input": {"command": "git reset --hard HEAD~1"}},
            repo,
            harness="codex",
        )
        actual = decision_of(code, out)
        ok = actual == "deny"
        print(f"  {'pass ' if ok else 'FAIL '} Codex without approval path denies ask: "
              f"expected deny, got {actual}")
        failures += 0 if ok else 1

    failures += configchange_fixture_checks(repo)
    shared_failures = failures

    compat = read_json(repo / ".agents" / "compatibility.json", {}) or {}
    claims = [h for h, level in (compat.get("enforcement") or {}).items() if level == "blocking"]
    reuse_current = promote_codex or promote_claude
    reused: list[str] = []
    codex_version = ""
    codex_live_passed = False
    codex_requested = "codex" in claims or promote_codex
    if codex_requested and reuse_current:
        state = provider_promotion_state(repo, "codex", compat)
        if state["current"]:
            codex_requested = False
            reused.append("codex")
            print("  pass  Codex promotion fast path: current checkout evidence, provider "
                  "version, settings, and trusted hook source still match")
    if codex_requested:
        live_failures, codex_version = live_codex_self_test(repo)
        failures += len(live_failures)
        codex_live_passed = not live_failures
        for problem in live_failures:
            print(f"        {problem}")
    claude_version = ""
    claude_live_passed = False
    claude_requested = "claude-code" in claims or promote_claude
    if claude_requested and reuse_current:
        state = provider_promotion_state(repo, "claude-code", compat)
        if state["current"]:
            claude_requested = False
            reused.append("claude-code")
            print("  pass  Claude promotion fast path: current checkout evidence, provider "
                  "version, settings, and workspace trust still match")
    if claude_requested:
        live_failures, claude_version = live_claude_self_test(repo)
        failures += len(live_failures)
        claude_live_passed = not live_failures
        for problem in live_failures:
            print(f"        {problem}")
    unsupported = [h for h in claims if h not in {"codex", "claude-code"}]
    for harness_name in unsupported:
        print(f"  FAIL  {harness_name} is declared blocking but has no provider-specific live probe")
        failures += 1
    print()
    if shared_failures:
        print(f"self-test: {failures} failure(s). Shared gate failures prevent every provider "
              "from earning evidence.")
        return 1
    if failures:
        print(f"self-test: {failures} provider failure(s). Successful providers below retain "
              "their independent evidence; failed providers do not.")
    else:
        print("self-test: all gates fired as declared.")
    # Evidence is written only on the path that actually ran the provider. A harness whose
    # live probes never ran keeps whatever evidence it already had, so one provider's run
    # can never refresh or invalidate another's.
    recorded: list[str] = []
    pending_evidence: list[tuple[str, bool, dict, str]] = []
    for harness_name, requested, promote, version, digest_of, summary in (
        ("codex", codex_live_passed, promote_codex, codex_version, codex_adapter_digest,
         "live Bash, apply_patch, and MCP denials"),
        ("claude-code", claude_live_passed, promote_claude, claude_version, claude_adapter_digest,
         "live Bash, Write, and MCP denials, target settings, trust, and the ConfigChange fixture"),
    ):
        if not requested:
            continue
        digest = digest_of(repo)
        if not digest:
            print(f"  ERROR: {harness_name} adapter files disappeared before evidence could "
                  "be recorded.", file=sys.stderr)
            return 1
        record = {
            "verifiedOn": date.today().isoformat(),
            "harnessVersion": version,
            "adapterSha256": digest,
            "method": "live-deny-and-observe",
        }
        pending_evidence.append((harness_name, promote, record, summary))

    # A tracked claim describes repository bytes, while this file proves THIS checkout and
    # installed provider actually ran them. Write the checkout-local half first: if Git has
    # no private worktree directory or it is unwritable, promotion must leave no portable
    # blocking claim behind for another checkout to inherit accidentally.
    for harness_name, _promote, record, _summary in pending_evidence:
        try:
            local_written = write_checkout_evidence(repo, harness_name, record)
        except OSError as exc:
            print(f"  ERROR: could not record checkout-local {harness_name} evidence ({exc}).",
                  file=sys.stderr)
            return 1
        if not local_written:
            print(f"  ERROR: {repo} has no checkout-private Git directory, so {harness_name} "
                  "cannot be promoted honestly.", file=sys.stderr)
            return 1

    for harness_name, promote, record, summary in pending_evidence:
        evidence = compat.setdefault("enforcementEvidence", {})
        if promote:
            compat.setdefault("enforcement", {})[harness_name] = "blocking"
        evidence[harness_name] = record
        recorded.append(harness_name)
        print(f"  {harness_name} repository and checkout evidence rewritten from {summary}.")
        if promote:
            print(f"  compatibility.json sets {harness_name} enforcement to blocking.")
    if recorded:
        write_json(repo / ".agents" / "compatibility.json", compat)
    resulting_claims = [h for h, level in (compat.get("enforcement") or {}).items()
                        if level == "blocking"]
    if resulting_claims:
        proven = {"codex": codex_live_passed, "claude-code": claude_live_passed}
        tested = [h for h in resulting_claims if proven.get(h)]
        direct = [h for h in resulting_claims if not proven.get(h) and h not in reused]
        if tested:
            print(f"  live provider-backed: {', '.join(tested)}")
        if reused:
            print(f"  current checkout evidence reused: {', '.join(reused)}")
        if direct:
            print(f"  direct-script only in this run: {', '.join(direct)}")
    else:
        print("  no harness declares `blocking` yet; raise it in compatibility.json when ready.")
    return 1 if failures else 0


# ── measure ───────────────────────────────────────────────────────────────────────────

def cmd_measure(repo: Path, as_json: bool, verbose: bool) -> int:
    """Fire every fence the repo declares and report which ones actually held.

    `self-test` proves the UNIVERSAL rules fire. It has never touched a repo's own
    policy, which is where all three of the inert-fence defects lived. This is the
    command that makes `enforcement: blocking` a measurement rather than a claim.
    """
    import measure as measure_lib

    hook_dir = repo / HOOK_DIR_NAME
    if not hook_dir.is_dir():
        print("agentkit: no installed hooks. Run `agentkit apply` first.", file=sys.stderr)
        return 2

    report = measure_lib.measure(repo, hook_dir)
    if as_json:
        print(json.dumps(report, indent=2))
        return 2 if report.get("error") else (
            1 if any(r["verdict"] in measure_lib.BROKEN for r in report["rules"])
            or report.get("overbroad") or report.get("coverage") else 0)

    print(f"agentkit measure -> {repo}\n")
    text, code = measure_lib.render(report, verbose)
    print(text)
    return code


# ── census ────────────────────────────────────────────────────────────────────────────

def cmd_census(repo: Path, as_json: bool) -> int:
    compat = read_json(repo / ".agents" / "compatibility.json", {}) or {}
    canonical = compat.get("canonical") or {}
    agents = repo / (canonical.get("instructions") or "AGENTS.md")
    shim = repo / (canonical.get("shim") or "CLAUDE.md")
    project = repo / (canonical.get("project") or "docs/project")
    skills_dir = repo / (canonical.get("skills") or ".agents/skills")

    def measure(path: Path) -> dict:
        if not path.exists():
            return {"exists": False, "bytes": 0, "lines": 0}
        text = path.read_text(encoding="utf-8", errors="replace")
        return {"exists": True, "bytes": path.stat().st_size, "lines": len(text.splitlines())}

    a, s = measure(agents), measure(shim)
    on_demand = sum(p.stat().st_size for p in project.rglob("*.md")) if project.is_dir() else 0
    n_skills = len([p for p in skills_dir.iterdir() if p.is_dir()]) if skills_dir.is_dir() else 0

    # Unscoped .claude/rules load at launch with the same priority as .claude/CLAUDE.md, so
    # include them in the startup-context baseline.
    rules_bytes, rules_lines, rules_files = 0, 0, []
    rules_dir = repo / ".claude" / "rules"
    if rules_dir.is_dir():
        for rule in sorted(rules_dir.rglob("*.md")):
            text = rule.read_text(encoding="utf-8", errors="replace")
            head = text[:text.find("\n---", 3)] if text.startswith("---") else ""
            if "paths:" in head:
                continue
            rules_bytes += rule.stat().st_size
            rules_lines += len(text.splitlines())
            rules_files.append(str(rule.relative_to(repo)))

    codex_bytes = a["bytes"]
    claude_bytes = a["bytes"] + s["bytes"] + rules_bytes
    claude_lines = a["lines"] + s["lines"] + rules_lines
    # 3.6-4.0 chars/token, calibrated against two harnesses agreeing at the per-skill entry.
    # A band, not a constant: prefer the byte figures for any decision that can use them.
    lo, hi = claude_bytes / 4.0, claude_bytes / 3.6

    data = {
        "repo": str(repo),
        "codexVisibleBytes": codex_bytes,
        "claudeVisibleBytes": claude_bytes,
        "claudeVisibleLines": claude_lines,
        "onDemandBytes": on_demand,
        "onDemandTokensIfImported": [round(on_demand / 4.0), round(on_demand / 3.6)],
        "projectSkills": n_skills,
        "unscopedRulesBytes": rules_bytes,
        "unscopedRulesFiles": rules_files,
        "repoAuthoredTokensEstimate": [round(lo), round(hi)],
    }

    if as_json:
        print(json.dumps(data, indent=2))
        return 0

    print(f"agentkit census -> {repo}\n")
    print(f"  Codex-visible   {codex_bytes:>8,} bytes  ({100*codex_bytes/32768:.1f}% of the 32,768 cap)")
    print(f"  Claude-visible  {claude_bytes:>8,} bytes / {claude_lines} lines")
    if rules_bytes:
        print(f"    of which      {rules_bytes:>8,} bytes  UNSCOPED .claude/rules — always-loaded:")
        for name in rules_files:
            print(f"                            {name}")
    print(f"  project skills  {n_skills:>8}        (~90-100 tokens each, bodies load on trigger)")
    print(f"  on-demand corpus{on_demand:>8,} bytes  costs ZERO at startup; "
          f"~{round(on_demand/4.0):,}-{round(on_demand/3.6):,} tokens if it were @-imported")
    print(f"\n  repo-authored startup: ~{round(lo):,}-{round(hi):,} tokens (ESTIMATED on a 3.6-4.0 chars/token band)")
    print("  Harness baseline is on top of this and is not something the repo controls.")
    return 0


# ── entry point ───────────────────────────────────────────────────────────────────────

def main() -> int:
    parser = argparse.ArgumentParser(prog="agentkit", description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--version", action="version", version=f"agentkit {KIT_VERSION}")
    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("apply", help="install the mechanical layer (idempotent)")
    p.add_argument("--repo", default="."); p.add_argument("--force", action="store_true")
    p.add_argument("--dry-run", action="store_true", help="show the footprint, change nothing")
    p.add_argument("--allow-dirty", action="store_true", help="proceed on an already-dirty tree")

    p = sub.add_parser("migrate", help="mechanical migration + a written plan for the judgment calls")
    p.add_argument("--repo", default=".")
    p.add_argument("--apply", action="store_true", help="perform the mechanical actions (default: plan only)")
    p.add_argument("--plan-out", default=None, help="write the plan here instead of stdout")
    p.add_argument("--allow-dirty", action="store_true")

    p = sub.add_parser("policy", help="harvest a draft policy from what the repo already enforces")
    p.add_argument("action", choices=["scaffold", "promote", "repair"])
    p.add_argument("--repo", default=".")

    p = sub.add_parser("supersede", help="prove the kit's gate is never weaker, then retire the legacy one")
    p.add_argument("--repo", default=".")
    p.add_argument("--gate", default=None, help="a specific legacy gate (default: all in .claude/hooks)")
    p.add_argument("--retire", action="store_true", help="quarantine and unwire it (only if safe)")
    p.add_argument("--allow-dirty", action="store_true")

    p = sub.add_parser("fleet", help="stage + census for every repository under a root")
    p.add_argument("--root", default=str(Path.home() / "dev"))
    p.add_argument("--json", action="store_true")
    p.add_argument("--verify", action="store_true", help="also count errors per repo (slower)")

    p = sub.add_parser("revert", help="undo the last mechanical migration from its manifest")
    p.add_argument("--repo", default=".")

    p = sub.add_parser("verify", help="the residue checks; exits non-zero on error")
    p.add_argument("--repo", default="."); p.add_argument("--effective", action="store_true")
    p.add_argument("--strict", action="store_true"); p.add_argument("--json", action="store_true")
    p.add_argument("--agnix", action="store_true",
                   help="also run the shared agnix catalogue (fetched via npx; fails if it cannot run)")

    p = sub.add_parser("self-test", help="fire forbidden calls at the hooks and assert refusal")
    p.add_argument("--repo", default=".")
    p.add_argument("--promote-codex", action="store_true",
                   help="run live Codex Bash/write/MCP probes and mark Codex blocking only on success")
    p.add_argument("--promote-claude", action="store_true",
                   help="run live Claude Bash/Write/MCP and target-checkout probes plus the "
                        "ConfigChange fixture, then mark Claude Code blocking only on success")

    p = sub.add_parser("census", help="Phase-0 measurement")
    p.add_argument("--repo", default="."); p.add_argument("--json", action="store_true")

    p = sub.add_parser("measure", help="fire every declared fence and report what actually held")
    p.add_argument("--repo", default="."); p.add_argument("--json", action="store_true")
    p.add_argument("--verbose", "-v", action="store_true",
                   help="also list the fences that passed, and the unmeasured ones by reason")

    args = parser.parse_args()

    if args.command == "fleet":
        root = Path(args.root).resolve()
        if not root.is_dir():
            print(f"agentkit: {root} is not a directory", file=sys.stderr)
            return 2
        return cmd_fleet(root, args.json, args.verify)

    repo = Path(args.repo).resolve()
    if not repo.is_dir():
        print(f"agentkit: {repo} is not a directory", file=sys.stderr)
        return 2

    if args.command == "apply":
        return cmd_apply(repo, args.force, args.dry_run, args.allow_dirty)
    if args.command == "migrate":
        return cmd_migrate(repo, args.apply, args.plan_out, args.allow_dirty)
    if args.command == "policy":
        return cmd_policy(repo, args.action)
    if args.command == "supersede":
        return cmd_supersede(repo, args.gate, args.retire, args.allow_dirty)
    if args.command == "revert":
        return cmd_revert(repo)
    if args.command == "verify":
        return cmd_verify(repo, args.effective, args.strict, args.json, args.agnix)
    if args.command == "self-test":
        return cmd_self_test(repo, args.promote_codex, args.promote_claude)
    if args.command == "census":
        return cmd_census(repo, args.json)
    if args.command == "measure":
        return cmd_measure(repo, args.json, args.verbose)
    return 2


if __name__ == "__main__":
    sys.exit(main())
