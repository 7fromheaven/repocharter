# Paths the kit itself writes. Changes here are the kit's own footprint, not somebody's
# unrelated work-in-progress, so they must not make the kit refuse to re-run itself.
AGENTKIT_OWNED = (
    ".agents/",
    ".agnix.toml",
    ".claude/hooks/agentkit/",
    ".claude/settings.json",
    ".claude/skills/",
    ".codex/hooks.json",
    # The vendored runtime and managed hook lane are excluded from the unrelated-change
    # check so apply remains idempotent. Only `pre-commit` is claimed inside .githooks/;
    # other hook files remain user-owned.
    "kit/",
    ".githooks/pre-commit",
)

# apply CREATES the shim when absent and never modifies an existing one, so an UNTRACKED
# CLAUDE.md is ours while a modified tracked one is somebody's real edit and must still
# count as dirty. The distinction is the git status code, not the path.
AGENTKIT_OWNED_IF_UNTRACKED = ("CLAUDE.md",)


TOMBSTONE_MARK = "# agentkit tombstone."


def _is_tombstone(path: Path) -> bool:
    try:
        return TOMBSTONE_MARK in path.read_text(encoding="utf-8", errors="replace")[:400]
    except OSError:
        return False


def unrelated_changes(repo: Path) -> list[str] | None:
    """Return dirty paths outside the kit-owned footprint, or None for a non-Git path."""
    # -uall expands untracked DIRECTORIES into their files. Without it git reports a bare
    # `?? .claude/`, which matches none of the specific owned paths, and the kit refuses to
    # re-run over its own footprint.
    proc = subprocess.run(["git", "status", "--porcelain", "-uall"], cwd=repo,
                          capture_output=True, text=True)
    if proc.returncode != 0:
        return None

    dirty: list[str] = []
    for line in proc.stdout.splitlines():
        if not line.strip():
            continue
        code, path = line[:2], line[3:].strip().strip('"')
        if any(path.startswith(owned) for owned in AGENTKIT_OWNED):
            continue
        if code == "??" and path in AGENTKIT_OWNED_IF_UNTRACKED:
            continue
        # A tombstone lands wherever the old settings pointed, so no path prefix can
        # claim it. Its CONTENT identifies it, and it is ours — otherwise the apply
        # that writes one makes the next apply refuse the repo as dirty.
        if code == "??" and _is_tombstone(repo / path):
            continue
        dirty.append(path)
    return dirty


def preflight(repo: Path, allow_dirty: bool) -> int | None:
    """Refuse to mutate a repository that already has UNRELATED uncommitted work.

    Keeping installation changes separate makes the generated footprint reviewable. The
    explicit escape hatch supports workflows that intentionally combine changes.

    The kit's own footprint is excluded so a completed apply can be run again without
    requiring the generated files to be committed first.
    """
    dirty = unrelated_changes(repo)
    if dirty is None:
        print(f"  note: {repo} is not a git repository; proceeding without a tree check")
        return None
    if not dirty:
        return None
    if allow_dirty:
        print(f"  note: {len(dirty)} uncommitted change(s) present; --allow-dirty given, proceeding")
        return None
    print(f"agentkit: {repo} has {len(dirty)} uncommitted change(s).", file=sys.stderr)
    print("  Refusing, so this install stays reviewable on its own. Commit or stash first,",
          file=sys.stderr)
    print("  or pass --allow-dirty to stack it on top of the existing changes.", file=sys.stderr)
    return 2

