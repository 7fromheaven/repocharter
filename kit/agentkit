#!/usr/bin/env python3
"""Install and verify the portable agent-context layout in a repository.

Core commands:

  apply    writes ONLY mechanical parts -- the shim, the symlinks, the hooks block, the
           permission denials, the linter config, the declaration. It NEVER writes
           AGENTS.md's body and never touches docs/project/.

  verify   runs the checked-in schema/residue layer plus the repository's declared
           validation commands. --agnix adds the network-fetched shared catalogue.

  self-test  fires known-forbidden calls at the installed hooks and asserts refusal. This
             is required before a repo may declare `enforcement: blocking`.

  census     records the startup-context baseline before installation.

Everything is idempotent. Re-running apply on a conforming repo changes nothing.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import shutil
import subprocess
import sys
import tempfile
