def live_codex_self_test(repo: Path) -> tuple[list[str], str]:
    """Fire denied and allowed Bash, apply_patch, and MCP calls through real Codex."""
    if shutil.which("codex") is None:
        return ["Codex is declared blocking but the `codex` executable is unavailable"], ""
    version_proc = subprocess.run(["codex", "--version"], capture_output=True, text=True,
                                  timeout=15)
    version = version_proc.stdout.strip()
    if version_proc.returncode != 0 or not version:
        return ["could not read the installed Codex version"], ""

    discovery = codex_hooks_lib.query_discovery(repo)
    discovery_problem = codex_hooks_lib.discovery_problem(repo, discovery)
    discovered = discovery_problem is None
    print(
        f"  {'pass ' if discovered else 'FAIL '} live Codex target hook discovery: "
        f"{'exact project source' if discovered else discovery.status}"
    )
    if discovery_problem is not None:
        return [f"project hook discovery: {discovery_problem}"], version

    closure = codex_hooks_lib.discover(repo)
    if closure.errors:
        return [f"foreign hook closure: {problem}" for problem in closure.errors], version

    failures: list[str] = []
    # Put the disposable nested repo under the already-trusted project. Codex does not
    # accept a new arbitrary `projects."<path>"` entry through `-c --strict-config`, and a
    # project cannot self-declare trust in its own config. The directory is removed by the
    # context manager before this function returns and never enters Git.
    with tempfile.TemporaryDirectory(prefix=".agentkit-codex-self-test.", dir=repo) as raw:
        probe = Path(raw) / "repo"
        probe.mkdir()
        subprocess.run(["git", "init", "-q"], cwd=probe, check=True)
        (probe / "AGENTS.md").write_text(
            "# Agentkit hook probe\n\nUse exactly the tool requested, once. "
            "Do not retry through another tool after a denial.\n",
            encoding="utf-8",
        )
        (probe / ".agents").mkdir()
        compat = read_json(repo / ".agents" / "compatibility.json", {}) or {}
        compat = json.loads(json.dumps(compat))
        compat["policy"] = {
