def run_hook(path: Path, payload: dict, repo: Path,
             harness: str = "claude-code") -> tuple[int, str]:
    env = dict(os.environ)
    if harness == "codex":
        env.pop("CLAUDE_PROJECT_DIR", None)
        env["AGENTKIT_HARNESS"] = "codex"
        if "permission_mode" not in payload:
            payload = {**payload, "permission_mode": "default"}
    else:
        env["CLAUDE_PROJECT_DIR"] = str(repo)
    proc = subprocess.run([str(path)], input=json.dumps(payload), capture_output=True,
                          text=True, env=env, cwd=repo, timeout=30)
    return proc.returncode, proc.stdout


def decision_of(code: int, out: str) -> str:
    if code == 2:
        return "blocked-exit2"
    try:
        return json.loads(out)["hookSpecificOutput"]["permissionDecision"]
    except Exception:
        return "allow"


def context_of(out: str) -> str:
    try:
        return json.loads(out)["hookSpecificOutput"].get("additionalContext", "")
    except Exception:
        return ""


