CODEX_ADAPTER_FILES = (
    ".codex/hooks.json",
    ".claude/hooks/agentkit/_policy.py",
    ".claude/hooks/agentkit/pretooluse-bash.sh",
    ".claude/hooks/agentkit/pretooluse-write.py",
