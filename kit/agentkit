def merge_compat(existing: dict, fresh: dict) -> dict:
    """Carry an existing declaration forward, adding only genuinely new keys.

    Never overwrite what the repo declared. The version stamp is the one exception: it is
    what the cross-repo drift check reads, so it must reflect the kit actually installed.
    """
    out = dict(fresh)
    for key, value in existing.items():
        if key == "agentkitVersion":
            continue
        if key == "adapters" and isinstance(value, list):
            # Match an adapter by harness + source. This preserves an existing repo's
            # deliberate import-vs-symlink choice while adding newly required adapters,
            # such as the explicit project-skills reach path introduced in 0.3.0.
            merged_adapters = list(fresh.get("adapters") or [])
            for adapter in value:
                if not isinstance(adapter, dict):
                    merged_adapters.append(adapter)
                    continue
                identity = (adapter.get("harness"), adapter.get("from"))
                replaced = False
                for index, candidate in enumerate(merged_adapters):
                    candidate_identity = (candidate.get("harness"), candidate.get("from"))
                    if identity == candidate_identity:
                        merged_adapters[index] = adapter
                        replaced = True
                        break
                if not replaced:
                    merged_adapters.append(adapter)
            out[key] = merged_adapters
            continue
        if isinstance(value, dict) and isinstance(out.get(key), dict):
            merged = dict(out[key])
            merged.update(value)
            out[key] = merged
        else:
            out[key] = value
    out["agentkitVersion"] = KIT_VERSION
    return out


